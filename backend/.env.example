# ---- AItranscriber backend (.env) ----
# Copy this file to: backend/.env
# DO NOT commit backend/.env (it contains secrets)

# Groq (Whisper)
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
# Optional override (backend also tries fallbacks)
# GEMINI_MODEL=gemini-2.5-flash

# Neon (Postgres)
# Get this from your Neon project dashboard (Connection Details).
# Keep "?sslmode=require" — Neon requires SSL.
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_NEON_HOST/YOUR_DB?sslmode=require

# Auth/JWT
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# Local audio storage
# Folder (relative to backend/) where uploaded audio files are saved.
AUDIO_STORAGE_DIR=storage/audio
# Base URL the backend is reachable at, used to build audio file links.
AUDIO_BASE_URL=http://127.0.0.1:8001

# Pinecone (optional: enables semantic search)
PINECONE_API_KEY=YOUR_PINECONE_API_KEY
PINECONE_INDEX=YOUR_PINECONE_INDEX_NAME
